# 3 metode pre processing

def clahe(img):
    lab = cv2.cvtColor(img, cv2.COLOR_RGB2LAB)
    l, a, b = cv2.split(lab)
    l = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8)).apply(l)
    return cv2.cvtColor(cv2.merge([l, a, b]), cv2.COLOR_LAB2RGB)

def shades_of_gray(img, p=6):
    x = img.astype(np.float32)
    cahaya = np.power(np.mean(np.power(x, p), axis=(0, 1)), 1.0 / p)
    cahaya = cahaya / (np.linalg.norm(cahaya) + 1e-8)
    x = x / (cahaya * np.sqrt(3) + 1e-8)
    return np.clip(x, 0, 255).astype(np.uint8)

def praproses(img, mode):
    if mode == "baseline":
        return img
    if mode == "clahe":
        return clahe(img)
    if mode == "sog":
        return shades_of_gray(img)

