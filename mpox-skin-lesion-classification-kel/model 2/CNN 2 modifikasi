# membungkus semua langkah jadi satu fungsi

def latih_fold(fold, mode, epochs=None):
    epochs = epochs or CFG["epochs"]
    tag = f"{CFG['nama']}_{mode}"
    folder_hasil = f"results/{tag}/fold{fold}"
    os.makedirs(folder_hasil, exist_ok=True)

    # 1. data
    X_train, y_train, X_val, y_val, X_test, y_test = muat_data(fold, mode)
    print(f"[Fold {fold} | {mode}] train={len(y_train)} valid={len(y_val)} test={len(y_test)}")

    jumlah = np.bincount(y_train, minlength=len(KELAS))
    cw = {i: len(y_train) / (len(KELAS) * max(jumlah[i], 1)) for i in range(len(KELAS))}

    # 2. model
    tf.keras.backend.clear_session()
    tf.keras.utils.set_random_seed(42)
    model = buat_model()
    model.compile(optimizer=buat_optimizer(),
                  loss="sparse_categorical_crossentropy", metrics=["accuracy"])

    # 3. training
    history = model.fit(
        X_train, y_train, validation_data=(X_val, y_val),
        epochs=epochs, batch_size=CFG["batch_size"], class_weight=cw,
        callbacks=buat_callbacks(),
        verbose=2)

    # 4. learning curve
    fig, ax = plt.subplots(1, 2, figsize=(11, 4))
    ax[0].plot(history.history["loss"], label="Training loss")
    ax[0].plot(history.history["val_loss"], label="Validation loss")
    ax[0].set_title("Learning Curve - Loss"); ax[0].set_xlabel("Epoch"); ax[0].legend(); ax[0].grid(True)
    ax[1].plot(history.history["accuracy"], label="Training accuracy")
    ax[1].plot(history.history["val_accuracy"], label="Validation accuracy")
    ax[1].set_title("Learning Curve - Accuracy"); ax[1].set_xlabel("Epoch"); ax[1].legend(); ax[1].grid(True)
    plt.tight_layout(); plt.savefig(f"{folder_hasil}/training_curve.png", dpi=150); plt.close()

    # 5. evaluasi test
    probabilitas = model.predict(X_test, verbose=0)
    y_pred = np.argmax(probabilitas, axis=1)
    hasil = {
        "accuracy": accuracy_score(y_test, y_pred),
        "precision": precision_score(y_test, y_pred, average="macro", zero_division=0),
        "recall": recall_score(y_test, y_pred, average="macro", zero_division=0),
        "f1": f1_score(y_test, y_pred, average="macro", zero_division=0),
        "roc_auc": roc_auc_score(y_test, probabilitas / probabilitas.sum(1, keepdims=True),
                                 multi_class="ovr", average="macro"),
        "val_loss_terbaik": min(history.history["val_loss"]),
        "val_accuracy_terbaik": max(history.history["val_accuracy"]),
    }
    print("HASIL TEST:", {k: round(float(v), 4) for k, v in hasil.items()})
    json.dump({k: float(v) for k, v in hasil.items()}, open(f"{folder_hasil}/metrics.json", "w"), indent=2)
    np.savez_compressed(f"{folder_hasil}/test_predictions.npz", y_test=y_test, y_pred=y_pred)

    # 6. confusion matrix
    cm = confusion_matrix(y_test, y_pred, labels=range(len(KELAS)))
    plt.figure(figsize=(7, 6))
    sns.heatmap(cm, annot=True, fmt="d", cmap="Blues", xticklabels=KELAS, yticklabels=KELAS)
    plt.xlabel("Prediksi"); plt.ylabel("Sebenarnya"); plt.title(f"Confusion Matrix - Fold {fold}")
    plt.xticks(rotation=45, ha="right"); plt.tight_layout()
    plt.savefig(f"{folder_hasil}/confusion_matrix.png", dpi=150); plt.close()

    # 7. kurva ROC
    y_bin = label_binarize(y_test, classes=list(range(len(KELAS))))
    plt.figure(figsize=(7, 6))
    for i, k in enumerate(KELAS):
        if y_bin[:, i].sum() == 0:
            continue
        fpr, tpr, _ = roc_curve(y_bin[:, i], probabilitas[:, i])
        plt.plot(fpr, tpr, label=f"{k} (AUC={auc(fpr, tpr):.3f})")
    plt.plot([0, 1], [0, 1], "k--")
    plt.xlabel("False Positive Rate"); plt.ylabel("True Positive Rate")
    plt.title(f"ROC Curve - Fold {fold}"); plt.legend(fontsize=8); plt.tight_layout()
    plt.savefig(f"{folder_hasil}/roc_curve.png", dpi=150); plt.close()

    open(f"{folder_hasil}/classification_report.txt", "w").write(
        classification_report(y_test, y_pred, target_names=KELAS, zero_division=0))
    return hasil

