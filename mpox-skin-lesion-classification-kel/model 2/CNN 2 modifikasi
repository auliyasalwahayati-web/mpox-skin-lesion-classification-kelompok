# UKURAN diambil dari CFG (model 1: 128, model 2: 160)

def muat_folder(folder, mode):
    X, y = [], []
    if folder is None:
        return X, y
    for i, k in enumerate(KELAS):
        p = os.path.join(folder, k)
        if not os.path.isdir(p):
            continue
        for nama in sorted(os.listdir(p)):
            img = cv2.imread(os.path.join(p, nama))
            if img is None:
                continue
            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
            img = cv2.resize(img, (UKURAN, UKURAN), interpolation=cv2.INTER_AREA)
            X.append(praproses(img, mode))
            y.append(i)
    return X, y

def muat_data(fold, mode):
    X1, y1 = muat_folder(cari_folder("original", fold, "train"), mode)
    X2, y2 = muat_folder(cari_folder("augment", fold, "train"), mode)
    X_train = np.array(X1 + X2, dtype=np.uint8)
    y_train = np.array(y1 + y2)

    Xv, yv = muat_folder(cari_folder("original", fold, "valid"), mode)
    Xt, yt = muat_folder(cari_folder("original", fold, "test"), mode)
    return (X_train, y_train, np.array(Xv, dtype=np.uint8), np.array(yv),
            np.array(Xt, dtype=np.uint8), np.array(yt))

