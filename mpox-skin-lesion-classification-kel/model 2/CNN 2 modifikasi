# Perbedaan dibanding model 1:
#   - Input 128x128 -> 160x160
#   - Sebagian layer awal backbone dibekukan (freeze), sisanya di-fine-tune
#   - Head diganti: Dropout -> Dense(softmax) menjadi
#       BatchNorm -> Dropout(0.4) -> Dense(256, ELU + L2) -> BatchNorm -> Dropout(0.3) -> Dense(softmax)

def buat_model():
    dasar = tf.keras.applications.EfficientNetB0(
        include_top=False, weights="imagenet",
        input_shape=(UKURAN, UKURAN, 3), pooling="avg")

    # freeze N layer pertama (fitur tingkat rendah: tepi, tekstur), sisanya dilatih
    dasar.trainable = True
    for layer in dasar.layers[:CFG["freeze_layer"]]:
        layer.trainable = False

    model = tf.keras.Sequential([
        tf.keras.layers.Input(shape=(UKURAN, UKURAN, 3)),
        dasar,
        tf.keras.layers.BatchNormalization(),
        tf.keras.layers.Dropout(CFG["dropout_1"]),
        tf.keras.layers.Dense(CFG["dense_unit"], activation=CFG["aktivasi"],
                              kernel_regularizer=tf.keras.regularizers.l2(CFG["l2"])),
        tf.keras.layers.BatchNormalization(),
        tf.keras.layers.Dropout(CFG["dropout_2"]),
        tf.keras.layers.Dense(len(KELAS), activation="softmax")
    ])
    return model

def buat_optimizer():
    try:
        return tf.keras.optimizers.AdamW(learning_rate=CFG["lr"], weight_decay=CFG["weight_decay"])
    except AttributeError:   # TensorFlow versi lama belum punya AdamW
        return tf.keras.optimizers.Adam(learning_rate=CFG["lr"])

def buat_callbacks():
    return [
        tf.keras.callbacks.EarlyStopping(monitor="val_loss", patience=CFG["patience"],
                                         restore_best_weights=True),
        tf.keras.callbacks.ReduceLROnPlateau(monitor="val_loss", factor=0.5,
                                             patience=2, min_lr=1e-6, verbose=1),
    ]

model = buat_model()
